{
  "name": "ships-n-cargo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/express": "^5.0.6",
    "@vitest/coverage-v8": "5.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.1"
  },
  "scripts": {
    "lint": "biome ci --error-on-warnings && npm run lint:error-architecture",
    "lint:error-architecture": "node --import tsx scripts/check-error-architecture.ts",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "start": "tsx src/bootstrap/server.ts",
    "build": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "uuidv7": "^1.2.1"
  }
}
